# +--------------------+
# |     DOCKERFILE     |
# +--------------------+

# Dockerfile for local development
# Build: >_ docker build -f Dockerfile.local -t smart-nutri-bot-local .

FROM python:3.11.9-slim-bookworm

# Set the working directory inside the container.
WORKDIR /app

# 1. Install system dependencies.
# git is sometimes required by pip for installing certain packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Copy the requirements file first to leverage Docker's layer caching.
COPY requirements.txt .

# 3. Install Python dependencies from your local requirements.txt.
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copy all your local application files (like app.py) into the image.
COPY . .

# 5. Expose the port Streamlit will run on.
EXPOSE 7860

# 6. Set the command to run the Streamlit application.
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=7860"]
